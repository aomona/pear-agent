{
  "name": "@pear-agent/outing-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:migrate:local": "wrangler d1 migrations apply pear-outing-execution --local",
    "db:migrate:remote": "wrangler d1 migrations apply pear-outing-execution --remote",
    "predev": "pnpm db:migrate:local",
    "dev": "concurrently -k -n worker,web -c blue,green \"pnpm dev:worker\" \"pnpm dev:web\"",
    "dev:worker": "wrangler dev --port 8787",
    "dev:web": "vite --config web/vite.config.ts",
    "deploy": "wrangler deploy",
    "typecheck": "tsgo --noEmit -p tsconfig.worker.json && tsgo --noEmit -p tsconfig.web.json",
    "test": "vitest run --config ../../vitest.config.ts tests"
  },
  "dependencies": {
    "@google/genai": "^2.11.0",
    "@pear-agent/cloudflare": "workspace:*",
    "@pear-agent/core": "workspace:*",
    "@pear-agent/outing-domain-example": "workspace:*",
    "@pear-agent/react": "workspace:*",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@tanstack/react-query": "^5.101.2",
    "agents": "^0.17.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.12.29",
    "lucide-react": "^0.525.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260711.1",
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "tailwindcss": "^4.1.11",
    "vite": "^8.0.12",
    "vitest": "^4.1.6",
    "wrangler": "^4.110.0"
  }
}
