{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pear-outing-agent",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "ExecutionSessionAgent",
        "class_name": "ExecutionSessionAgent",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ExecutionSessionAgent"],
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pear-outing-execution",
      "database_id": "local-pear-outing-execution",
      // Single source of truth: packages/cloudflare/migrations (do not fork SQL here).
      "migrations_dir": "../../packages/cloudflare/migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "RAW_INPUTS",
      "bucket_name": "pear-outing-raw-inputs",
    },
  ],
}
