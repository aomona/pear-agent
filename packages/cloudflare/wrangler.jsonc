{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pear-agent-cloudflare",
  "main": "src/test-worker.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "ExecutionSessionAgent",
        "class_name": "ExecutionSessionAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ExecutionSessionAgent"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pear-execution",
      "database_id": "local-pear-execution",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RAW_INPUTS",
      "bucket_name": "pear-raw-inputs"
    }
  ]
}
