{
  "name": "pear-minimal-starter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:migrate:local": "wrangler d1 migrations apply pear-minimal-starter --local",
    "db:migrate:remote": "wrangler d1 migrations apply pear-minimal-starter --remote",
    "predev": "pnpm db:migrate:local",
    "dev": "concurrently -k -n worker,web -c blue,green \"pnpm dev:worker\" \"pnpm dev:web\"",
    "dev:worker": "wrangler dev --port 8787",
    "dev:web": "vite",
    "build": "vite build",
    "predeploy": "pnpm build",
    "deploy": "wrangler deploy",
    "typecheck": "tsgo --noEmit -p tsconfig.worker.json && tsgo --noEmit -p tsconfig.web.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.93",
    "@google/genai": "^2.11.0",
    "@pear-agent/ai": "workspace:*",
    "@pear-agent/cloudflare": "workspace:*",
    "@pear-agent/core": "workspace:*",
    "@pear-agent/react": "workspace:*",
    "@tanstack/react-query": "^5.101.2",
    "agents": "^0.17.3",
    "hono": "^4.12.29",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260711.1",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@typescript/native-preview": "7.0.0-dev.20260702.3",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "vite": "^8.0.12",
    "vitest": "^4.1.6",
    "wrangler": "^4.110.0"
  }
}
