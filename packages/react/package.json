{
  "name": "@pear-agent/react",
  "version": "0.1.0-beta.1",
  "homepage": "https://github.com/aomona/pear-agent#readme",
  "bugs": {
    "url": "https://github.com/aomona/pear-agent/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aomona/pear-agent.git",
    "directory": "packages/react"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "beta"
  },
  "scripts": {
    "build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\" && tsgo -p tsconfig.build.json",
    "prepack": "pnpm build",
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@pear-agent/core": "workspace:0.1.0-beta.1",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@google/genai": "^2.11.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "agents": "^0.17.3",
    "jsdom": "^26.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vitest": "^4.1.6"
  },
  "peerDependencies": {
    "@google/genai": "^1.0.0 || ^2.0.0",
    "agents": "^0.17.0",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@google/genai": {
      "optional": true
    },
    "agents": {
      "optional": true
    }
  }
}
